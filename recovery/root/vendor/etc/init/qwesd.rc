# Daemon is started from init.recovery.qcom.rc after crypto.ready=1
# to ensure /data/vendor/qwes directory exists

# Used 'disabled' flag, so daemon won't be started until explicit start
service vendor.qwesd /vendor/bin/qwesd
    class late_start
    user root
    group root system inet
    disabled
    socket qwes_ipc stream 0660 root system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/odm/lib64:/system/lib64:/sbin
    seclabel u:r:recovery:s0
