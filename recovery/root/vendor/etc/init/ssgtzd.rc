# Start daemon on early-init
on early-boot
    start vendor.ssgtzd

# (qwes data dir is created by init.recovery.qcom.rc at crypto.ready=1)
# (this trigger is not exported in vendor init files, so it's in the main rc)

# Used 'disabled' flag, so daemon won't be started until explicit start
service vendor.ssgtzd /vendor/bin/ssgtzd
    class late_start
    user root
    group root system oem_2912 wakelock
    capabilities WAKE_ALARM BLOCK_SUSPEND
    disabled
    socket ssgtzd stream 0660 system oem_2912
    socket ssgtzd_opener stream 0660 system system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/odm/lib64:/system/lib64:/sbin
    seclabel u:r:recovery:s0
